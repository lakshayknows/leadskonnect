# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
*.tsbuildinfo
out/
build/
next-env.d.ts

# production
dist/

# secrets — never commit these.
# The glob is deliberately broad: a `.env.local.bak-1786350040` written by a
# quick backup is just as sensitive as the file it copied.
.env
.env.*
!.env.example
*.bak
*.bak-*

# prisma generated client
prisma/generated/

# testing
coverage/
playwright-report/
test-results/
/e2e/.auth/

# misc
.DS_Store
*.pem
.vercel
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
